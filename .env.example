PORT=3000
# TRUST_PROXY=loopback, linklocal, uniquelocal — доверенные сети для X-Forwarded-For (Caddy в Docker). false — не доверять; true — только для отладки.
# Обязательно для локальной разработки (DevModule, логирование). start:dev тоже выставляет development.
NODE_ENV=development
# /dev/* (last-otp и др.) — только при NODE_ENV=development и ENABLE_DEV_ENDPOINTS=true
ENABLE_DEV_ENDPOINTS=false

# Локальная Postgres или общий Neon. Если задан DATABASE_URL — он главнее DB_*.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/svels?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=svels
# DB_SSL=true — обязательно для Neon; для localhost можно не задавать
# DB_SSL_REJECT_UNAUTHORIZED=false — только если корпоративный TLS ломает цепочку

# --- Окружение / схема БД ---
# NODE_ENV=development — режим приложения (ConfigModule, DevModule, логирование)
# DB_SYNC=true — TypeORM synchronize (только локально; в проде схема через migration:run)

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_ENABLED=false — отключить кэш (если Redis не установлен локально)
# REDIS_PASSWORD= — пароль Redis (ioredis / CacheService)
# CACHE_TTL=3600 — TTL кэша по умолчанию (CacheService)

# --- Медиа / Object Storage (S3-совместимое: hoster.by, AWS, MinIO и т.д.) ---
# local — диск ./uploads (dev/e2e); s3 — внешнее хранилище (прод/пилот)
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.hoster.by
# S3_REGION=eu-central-1
# S3_BUCKET=svels-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com/svels-media
# Через запятую — старые публичные базы (например Yandex), для resolveKeyFromUrl:
# S3_LEGACY_PUBLIC_BASE_URLS=https://storage.yandexcloud.net/svels-media
#
# Устаревшие имена (fallback, пока не обновите .env): YANDEX_STORAGE_*
#
# --- storage:migrate (копирование бакета + опционально URL в БД) ---
# Источник (старый провайдер):
# SRC_S3_ENDPOINT=https://storage.yandexcloud.net
# SRC_S3_REGION=ru-central-1
# SRC_S3_BUCKET=svels-media
# SRC_S3_ACCESS_KEY_ID=
# SRC_S3_SECRET_ACCESS_KEY=
# SRC_S3_FORCE_PATH_STYLE=true
# SRC_S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/svels-media

# true (по умолчанию) — конвертация в API-процессе (удобно для local).
# false — только очередь BullMQ; нужен отдельный процесс: npm run start:worker
# IMAGE_WORKER_INLINE=false
# IMAGE_MAX_WIDTH=1600
# IMAGE_JPEG_QUALITY=82
# IMAGE_WEBP_QUALITY=80
# IMAGE_JOB_TIMEOUT_MS=60000
# IMAGE_PROCESSOR_IN_API=true — редко: processor в том же процессе, что и API

# --- Next.js / ISR ---
# NEXT_SITE_URL=http://localhost:3001 — базовый URL фронта (revalidation, bePaid return URL)
NEXT_SITE_URL=http://localhost:3001
# В production — минимум 32 символа, не значение из примера
REVALIDATE_SECRET=dev-revalidate-secret

# --- Публичный API ---
# API_PUBLIC_URL=http://127.0.0.1:3000 — webhook/return URL (bePaid, внешние интеграции)
API_PUBLIC_URL=http://127.0.0.1:3000

# --- CORS ---
# Статический whitelist Origin (через запятую) + динамически https://<customDomain> одобренных заведений (кэш 5 мин).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- bePaid (оплата онлайн) ---
# Ключи магазина задаются в админке заведения: /restaurant-admin/payment-settings
# BEPAY_CREDENTIALS_ENCRYPTION_KEY= — AES-ключ для Secret Key в БД (обязателен в production)
# BEPAY_SHOP_ID=
# BEPAY_SECRET_KEY=
# BEPAY_PUBLIC_KEY= — опционально, RSA public key для Content-Signature
BEPAY_TEST_MODE=true
# authorization = холд; payment = сразу списание (fallback, если нет настроек в админке)
BEPAY_CHECKOUT_TRANSACTION_TYPE=authorization
BEPAY_AUTO_CAPTURE=false
BEPAY_CURRENCY=BYN
# Локально webhook нужен публичный URL (ngrok) → https://xxxx.ngrok.io/payments/bepaid/webhook
# BEPAY_NOTIFICATION_URL=
# BEPAY_CHECKOUT_URL=https://checkout.bepaid.by
# BEPAY_GATEWAY_URL=https://gateway.bepaid.by

# В production — минимум 32 символа, не change-me-in-production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Guest OAuth (вход гостя в заведении через Google / Apple) ---
# GOOGLE_OAUTH_CLIENT_ID — client ID из Google Cloud (можно несколько через запятую)
GOOGLE_OAUTH_CLIENT_ID=
# APPLE_SERVICE_ID — Service ID (Sign in with Apple для веб)
APPLE_SERVICE_ID=
# APPLE_TEAM_ID — Team ID (нужен для включения Apple на бэкенде)
APPLE_TEAM_ID=
# APPLE_REDIRECT_URI — redirect URI, который видит клиент Apple JS
APPLE_REDIRECT_URI=

TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_GATEWAY_API_URL=https://gatewayapi.telegram.org

# --- Telegram-бот заказов (W1-B-TG) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

SMS_BY_TOKEN=
SMS_BY_ALPHANAME=Svels
# SMS_BY_API_URL=https://app.sms.by/api/v1

SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=Svels
# SMSC_API_URL=https://smsc.ru/sys/send.php

OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_TELEGRAM_WAIT_MS=20000
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5
# OTP_PEPPER= — по умолчанию JWT_SECRET

# --- Установка пароля (ссылки из писем/SMS) ---
# SET_PASSWORD_URL_BASE=https://app.example.com/auth/set-password — клиентская страница magic link
# SET_PASSWORD_TTL_HOURS=24 — срок жизни ссылки

# --- Наблюдаемость (Sentry) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT= — по умолчанию NODE_ENV
# SENTRY_RELEASE= — по умолчанию version из package.json
# SENTRY_WEBHOOK_SECRET= — client secret Internal Integration (webhook → Telegram)
# ERRORS_TELEGRAM_BOT_TOKEN= — отдельный бот для алертов ошибок (не TELEGRAM_BOT_TOKEN / LEADS_*)
# ERRORS_TELEGRAM_CHAT_ID=

# --- Rate limiting ---
# THROTTLER_STORAGE=redis — счётчики Throttler в Redis (prod/docker-compose); иначе in-memory
# POST /analytics/visits — отдельный лимит (см. AnalyticsController)

# --- Deploy (Caddy / compose) ---
# PLATFORM_DOMAIN=svels.by
# ADMIN_DOMAIN=admin.svels.by
# ACME_EMAIL=ops@example.com
# API_TAG=latest
# WEB_TAG=latest

# --- Заявки с лендинга → Telegram (бесплатно) ---
# 1) @BotFather → /newbot → скопировать токен
# 2) Написать боту любое сообщение
# 3) Открыть https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id
# LEADS_TELEGRAM_BOT_TOKEN=
# LEADS_TELEGRAM_CHAT_ID=
