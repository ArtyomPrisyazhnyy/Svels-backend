PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=svels

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_ENABLED=false — отключить кэш (если Redis не установлен локально)
CACHE_TTL=3600

# On-demand ISR: URL Next.js и общий секрет с Svels-client/.env
NEXT_SITE_URL=http://localhost:3001
REVALIDATE_SECRET=dev-revalidate-secret

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Только для npm run create:super-admin (после деплоя)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
